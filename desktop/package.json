{
  "name": "tab-tracker-desktop",
  "version": "1.9.1",
  "private": true,
  "description": "Always-on-top pill showing the focused desktop app and today's time in it.",
  "author": "Uthman Ajibade",
  "homepage": "https://tabtracker.uthman.xyz",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "install-electron",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "xyz.uthman.tabtracker",
    "productName": "Tab Tracker",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "publish": [
      {
        "provider": "github",
        "owner": "uthmanajibade03-droid",
        "repo": "tab-tracker"
      }
    ],
    "files": [
      "*.js",
      "renderer/**",
      "focus-watcher.ps1",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "TabTracker-mac-${arch}.zip",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Tab Tracker uses your microphone only while you are on a call with a teammate."
      }
    },
    "extraResources": [
      {
        "from": "../icons",
        "to": "icons",
        "filter": [
          "*.png"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "artifactName": "TabTracker-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tab Tracker"
    }
  }
}
