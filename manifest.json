{
  "manifest_version": 3,
  "name": "Tab Tracker",
  "version": "1.1.0",
  "description": "Track active time per site, share to-dos, prayer-time reminders, teammate voice calls, and per-site overuse alerts.",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms",
    "contextMenus",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "quick_add_todo": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "Quick-add a personal to-do from any tab"
    },
    "toggle_todo_widget": {
      "suggested_key": {
        "default": "Ctrl+Shift+H",
        "mac": "Command+Shift+H"
      },
      "description": "Show or hide the floating to-do widget"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Tracker",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "tab-timer.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
